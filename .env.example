# MongoDB
MONGO_ROOT_USERNAME = "Root username of the account"
MONGO_KEY = ""
SECRET_KEY = ""
MONGO_ROOT_PASSWORD = ""

# Redis
REDIS_HOST="IP address of the computer/server Redis is running (localhost if running locally)"
REDIS_PORT="port where Redis is running (recommended : 6379)"
REDIS_DB="number of database (default to 0)"
REDIS_PASSWORD="password for the redis database"

# Google web client
GOOGLE_WEB_CLIENT_ID="ID of Web Client using Google Console"
GOOGLE_WEB_CLIENT_SECRET="secret of Web Client using Google Console"
GOOGLE_ANDROID_CLIENT_ID="ID of Android Client using Google Console"